# xAI (Grok). Also read from ~/.grok/.env if present.
XAI_API_KEY=
XAI_MODEL=grok-4.20-non-reasoning

# Devices the server may talk to, comma separated.
#   speculos:<host>:<apdu-port>   a Speculos emulator (scripts/speculos.sh starts two: 9999 and 9998)
#   hid                           every Ledger plugged in over USB
DEVICES=speculos:127.0.0.1:9999,speculos:127.0.0.1:9998,hid

# Channel: "imessage" (Photon on the Mac signed into Messages) or "dev" (local HTTP + REPL for testing)
CHANNEL=dev
DEV_PORT=7777

# SQLite file
DB_PATH=data/agentsign.db
