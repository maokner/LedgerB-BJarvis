# xAI (Grok). Also read from ~/.grok/.env if present.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Device mode: "eth" (Ledger's Ethereum app, real ETH on Base mainnet) or "agentsign" (custom app, demo money)
DEVICE_MODE=eth
# Base JSON-RPC endpoint (eth mode)
BASE_RPC_URL=https://mainnet.base.org

# Devices the server may talk to (eth mode uses only "hid"), comma separated.
#   speculos:<host>:<apdu-port>   a Speculos emulator (scripts/speculos.sh starts two: 9999 and 9998)
#   hid                           every Ledger plugged in over USB
DEVICES=hid

# Channel: "telegram" (a bot; the default when TELEGRAM_BOT_TOKEN is set), "imessage" (Photon on the Mac
# signed into Messages) or "dev" (local HTTP + REPL for testing)
CHANNEL=telegram
# Bot token from @BotFather (/newbot). Create one with @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
DEV_PORT=7777

# Approval page (eth mode): every approval text links to PUBLIC_URL/sign/<token>, which signs over WebHID
# on any computer the Ledger is plugged into. WebHID needs https, so expose WEB_PORT with `ngrok http 7788`
# and put the https URL here. The default only works on this Mac.
WEB_PORT=7788
PUBLIC_URL=http://127.0.0.1:7788
# Interface the page listens on; 127.0.0.1 is enough for ngrok and `tailscale serve`.
WEB_HOST=127.0.0.1

# Google Calendar (eth mode, needs the web server): an OAuth client of type "Web application" from
# console.cloud.google.com with PUBLIC_URL/google/callback as an authorized redirect URI. Owners then say
# "connect my google calendar" and get a link. See the Google Calendar section in DESIGN.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Buying on Amazon with USDC on Base (eth mode). Owners pay the treasury; the server orders with the operator's
# own Amazon account and card, capped per order, and refunds from the treasury when nothing was ordered.
# See "Buying on Amazon" in DESIGN.md. Off unless a treasury is set.
# The treasury: an address that only receives (refunds are then sent by hand), or a private key that can also refund
# (keep a little ETH on it for gas; never commit it). With both, they must match.
TREASURY_ADDRESS=0xf8381484CD2639618c690572aB35ff65E4bd7C5e
TREASURY_PRIVATE_KEY=
# The operator's Amazon session as a Playwright storage state: `pnpm amazon:login` writes data/amazon-state.json.
# Either the JSON itself (or its base64) in AMAZON_STORAGE_STATE, or a file path in AMAZON_STORAGE_STATE_PATH.
AMAZON_STORAGE_STATE=
AMAZON_STORAGE_STATE_PATH=
# The store: "browser" (the default once a session is set) buys on amazon.com; "demo" uses a built-in catalog.
AMAZON_MERCHANT=mock
# 1: go through the whole checkout but never press "Place your order" (the buyer is refunded).
AMAZON_DRY_RUN=
# Per-order cap on the checkout total, item plus shipping and tax. Default 20.
PURCHASE_LIMIT_USD=20
# Where Amazon ships (the account's default address), in words, as told to buyers. Default "<operator>'s address".
PURCHASE_SHIPS_TO=Matt's address
# The operator: texted when a purchase needs a person (an unclear order, a failed refund). OPERATOR_NAME defaults to the tag.
OPERATOR_TAG=@mokner
OPERATOR_NAME=Matt

# SQLite file
DB_PATH=data/agentsign.db

# Calling Jarvis (src/voice/twilio.ts, voice/TWILIO.md): a Twilio number rings PUBLIC_URL/twilio/voice, the audio streams to
# wss://<PUBLIC_URL>/twilio/media and OpenAI's realtime model speaks as Jarvis with the same tools a text has. A call is
# recognised by caller ID: owners link their number once (they say it in Telegram, or call and text back the code they hear).
# On until OPENAI_API_KEY is empty.
OPENAI_API_KEY=
# gpt-realtime-2.1 (default), gpt-realtime-2.1-mini (cheaper) or gpt-realtime.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar (default: the deeper one).
OPENAI_VOICE=cedar
# Twilio console > Account info. The auth token signs every webhook; without it calls are refused (except on the dev channel).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number people call, E.164. Jarvis tells owners this number. scripts/twilio-setup.sh points it at PUBLIC_URL.
TWILIO_PHONE_NUMBER=
# Admin header for GET /voice/calls (recent calls with transcripts) and POST /voice/context (standing instructions for calls).
ADMIN_TOKEN=

# Voice over xAI (older path): bearer token the xAI console agent sends to our MCP server (Connectors > Custom MCP server)
MCP_TOKEN=
