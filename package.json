{
  "name": "agentsign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An iMessage agent whose risky actions are clear-signed on a Ledger device.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts --channel dev",
    "demo:chat": "tsx scripts/demo-chat.ts",
    "voice:chat": "tsx scripts/voice-chat.ts",
    "build:web": "tsx scripts/build-web.ts",
    "amazon:login": "tsx scripts/amazon-login.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ledgerhq/hw-app-eth": "^7.10.0",
    "@ledgerhq/hw-transport-node-hid": "^6.29.5",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@photon-ai/imessage-kit": "3.0.0",
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "better-sqlite3": "^12.5.0",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "playwright": "1.64.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ledgerhq/hw-transport-mocker": "^6.35.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-hid",
      "usb",
      "@ledgerhq/hw-transport-node-hid",
      "esbuild"
    ]
  }
}
